# ---------------------------------------------------------------------------
# Jan Drishti — environment variables
# Copy to .env.local for development. Never commit real values.
# Only NEXT_PUBLIC_* variables are exposed to the browser (and none of them
# is a secret: the Firebase web config is designed to be public).
# ---------------------------------------------------------------------------

# ---- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://jan-drishti.vercel.app

# ---- Firebase (client SDK — public by design) ------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin SDK (server only — SECRET) -----------------------------
# Either paste the whole service-account JSON on one line:
FIREBASE_SERVICE_ACCOUNT_JSON=
# …or supply the two fields separately (preferred on Vercel):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- AI research assistant (server only) -----------------------------------
# Any OpenAI-compatible endpoint. Leave blank to disable AI drafting; the
# fact-check pipeline then states that no AI was used (it never fakes output).
# One key is enough for the AI fact-check synthesis. Pick a provider and paste a key:
#   AI_PROVIDER=gemini     (free tier available)  AI_MODEL defaults to gemini-2.0-flash
#   AI_PROVIDER=groq       (free tier available)  AI_MODEL defaults to llama-3.3-70b-versatile
#   AI_PROVIDER=openai                            AI_MODEL defaults to gpt-4o-mini
#   AI_PROVIDER=openrouter | deepseek
AI_PROVIDER=gemini
AI_API_KEY=
# Optional overrides — only if you use a provider not listed above.
AI_BASE_URL=
AI_MODEL=
AI_TRANSLATION_MODEL=

# ---- Evidence search (server only) -----------------------------------------
# Configure at least one. With none configured, fact-check files report that
# no evidence could be retrieved and cannot recommend anything but UNVERIFIED.
# Optional paid search. The evidence step does NOT need these: Google News RSS,
# Bing News RSS, the trusted wire and Wikipedia are queried without credentials.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=

# ---- OCR -------------------------------------------------------------------
# Defaults to the AI vision model when an AI key is present.
OCR_PROVIDER=

# ---- Licensed news API (optional) ------------------------------------------
NEWS_API_KEY=
NEWS_API_PROVIDER=newsapi

# ---- Operations ------------------------------------------------------------
CRON_SECRET=change-me-to-a-long-random-string
IP_HASH_SALT=change-me-too
SUBMISSION_RATE_LIMIT=5
RESEARCH_RATE_LIMIT=10
