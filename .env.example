# ---------------------------------------------------------------------------
# Jan Drishti — environment variables
# Copy to .env.local for development. Never commit real values.
# Only NEXT_PUBLIC_* variables are exposed to the browser (and none of them
# is a secret: the Firebase web config is designed to be public).
# ---------------------------------------------------------------------------

# ---- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://jan-drishti.vercel.app

# ---- Firebase (client SDK — public by design) ------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin SDK (server only — SECRET) -----------------------------
# Either paste the whole service-account JSON on one line:
FIREBASE_SERVICE_ACCOUNT_JSON=
# …or supply the two fields separately (preferred on Vercel):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- AI research assistant (server only) -----------------------------------
# Any OpenAI-compatible endpoint. Leave blank to disable AI drafting; the
# fact-check pipeline then states that no AI was used (it never fakes output).
# The AI fact-check synthesis needs exactly one provider to answer. Providers are
# tried in order and the run continues on the next one when a key is exhausted,
# a model id is retired, or a request times out:
#   1. AI_PROVIDER + AI_API_KEY   (below)
#   2. GROQ_API_KEY / OPENROUTER_API_KEY / CEREBRAS_API_KEY / MISTRAL_API_KEY,
#      if present — all have free tiers
#   3. a KEYLESS free endpoint (Pollinations, open-weights model) — no signup,
#      no card, ~1 answer per 45 s per IP. Disable with AI_KEYLESS_FALLBACK=0.
#
#   AI_PROVIDER=gemini     (free tier: 20 calls/day)  AI_MODEL defaults to gemini-3.5-flash
#   AI_PROVIDER=groq       (free tier: generous)      AI_MODEL defaults to llama-3.3-70b-versatile
#   AI_PROVIDER=openrouter (":free" models)           AI_MODEL defaults to llama-3.3-70b-instruct:free
#   AI_PROVIDER=openai | cerebras | mistral | deepseek | pollinations
AI_PROVIDER=gemini
# Optional. Leave blank to run on the keyless free endpoint only.
AI_API_KEY=
# Optional overrides — only if you use a provider not listed above.
AI_BASE_URL=
# Google retires model ids without notice; a 404 is reported, never swallowed.
AI_MODEL=
AI_TRANSLATION_MODEL=
# Structured calls default to "minimal" so a reasoning model does not spend a
# minute thinking before it emits the JSON the pipeline needs.
AI_REASONING_EFFORT=minimal
# Off by default: a research run makes ONE model call, to write the verdict.
# Deterministic queries already retrieve the evidence. Set to 1 to also let the
# model split the claim and propose queries (costs a second call).
RESEARCH_AI_EXTRACTION=0
# 1 = use the keyless free endpoint when every keyed provider is unavailable
# (default). 0 = keyed providers only; the run then reports no AI was used.
AI_KEYLESS_FALLBACK=1
# Free keys for the fallback chain, all optional:
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=

# ---- Cross-check bench -------------------------------------------------------
# Every claim is read independently by this many models, then re-checked once
# against their answers. Two is the floor: one model agreeing with itself is not
# verification.
AI_ANALYSTS=2
# Extra voices from the same provider, spelled provider:model. A vendor's large
# and small models disagree often enough to be worth asking separately.
AI_ANALYST_MODELS=groq:qwen/qwen3.8-27b
# Who re-checks the analysts. Blank = best provider in the chain, failing over.
AI_ADJUDICATOR=

# ---- Evidence search (server only) -----------------------------------------
# Configure at least one. With none configured, fact-check files report that
# no evidence could be retrieved and cannot recommend anything but UNVERIFIED.
# Optional paid search. The evidence step does NOT need these: Google News RSS,
# Bing News RSS, the trusted wire and Wikipedia are queried without credentials.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=

# ---- OCR -------------------------------------------------------------------
# Defaults to the AI vision model when an AI key is present.
OCR_PROVIDER=

# ---- Licensed news API (optional) ------------------------------------------
NEWS_API_KEY=
NEWS_API_PROVIDER=newsapi

# ---- Operations ------------------------------------------------------------
CRON_SECRET=change-me-to-a-long-random-string
IP_HASH_SALT=change-me-too
SUBMISSION_RATE_LIMIT=5
RESEARCH_RATE_LIMIT=10
